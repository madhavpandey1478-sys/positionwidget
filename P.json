{
    "id": "com.madhav.positionentry",
    "version": "1.4.0",
    "name": "Position Entry",
    "description": "Position creation and maintenance data entry widget",
    "newInstancePrefix": "PositionEntry",
    "vendor": "Madhav Pandey",
    "eula": "",
    "license": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-positionentry",
            "url": "https://madhavpandey1478-sys.github.io/positionwidget/Pmain.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },
    "methods": {
        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event payload string. Parse with split('|'). Tab 1 payloads: fieldChange|rowIndex|fieldName|value, addRow|n, sendForApproval, VALID|0, INVALID|n. Tab 2 payloads: fieldChange2|rowIndex|fieldName|value, loadData, saveChanges|n, VALID2|0, INVALID2|n."
        },
        "getData": {
            "returnType": "string",
            "description": "Returns Tab 1 (Create Position) rows as a JSON string."
        },
        "setData": {
            "description": "Sets Tab 1 (Create Position) rows from a JSON string.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "JSON array of row objects."
                }
            ]
        },
        "setCellValue": {
            "description": "Sets a single cell value in Tab 1.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name, e.g. 'companyCode'."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Value to set."
                }
            ]
        },
        "setRowOptions": {
            "description": "Sets searchable dropdown options for a Tab 1 cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array: [{value,text},...] or ['val',...]."
                }
            ]
        },
        "getData2": {
            "returnType": "string",
            "description": "Returns Tab 2 (Load / Modify / Delete) rows as a JSON string."
        },
        "setData2": {
            "description": "Sets Tab 2 (Load / Modify / Delete) rows from a JSON string. Call this inside onDataChange after the loadData event fires.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "JSON array of row objects."
                }
            ]
        },
        "setCellValue2": {
            "description": "Sets a single cell value in Tab 2.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Value to set."
                }
            ]
        },
        "setRowOptions2": {
            "description": "Sets searchable dropdown options for a Tab 2 cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Zero-based row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array: [{value,text},...] or ['val',...]."
                }
            ]
        },
        "getActiveTab": {
            "returnType": "string",
            "description": "Returns 'create' or 'modify'."
        },
        "setActiveTab": {
            "description": "Switches the active tab programmatically.",
            "parameters": [
                {
                    "name": "tabKey",
                    "type": "string",
                    "description": "'create' or 'modify'."
                }
            ]
        }
    },
    "events": {
        "onDataChange": {
            "description": "Single event for all user interactions. Call getLastEvent() and split by '|' to branch. Tab 1 payloads: fieldChange|rowIndex|fieldName|value | addRow|n | deleteRow|n | copyRow|n | selectRow|n|true/false | sendForApproval | tabChange|create. Tab 2 payloads: fieldChange2|rowIndex|fieldName|value | loadData | saveChanges|n | deleteRow2|n | selectRow2|n|true/false | tabChange|modify."
        },
        "onValidate": {
            "description": "Fired when Validate is clicked on either tab. Call getLastEvent(): 'VALID|0' or 'INVALID|n' for Tab 1, 'VALID2|0' or 'INVALID2|n' for Tab 2."
        },
        "onReady": {
            "description": "Fired once when the widget has finished initialising. Use to set initial dropdown options and pre-populate Tab 1 with one empty row."
        }
    }
}
