{
    "id": "com.madhav.positionentry",
    "version": "1.1.0",
    "name": "Position Entry",
    "description": "Position creation and maintenance data entry widget",
    "newInstancePrefix": "PositionEntry",
    "vendor": "Madhav Pandey",
    "eula": "",
    "license": "",

    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-positionentry",
            "url": "https://madhavpandey1478-sys.github.io/positionwidget/Pmain.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],

    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },

    "methods": {

        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event generated by the widget."
        },

        "getData": {
            "returnType": "string",
            "description": "Returns the Create Position table data."
        },

        "setData": {
            "description": "Sets the Create Position table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Serialized Create Position table data."
                }
            ]
        },

        "setCellValue": {
            "description": "Sets a value in a Create Position table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Cell value."
                }
            ]
        },

        "setRowOptions": {
            "description": "Sets dropdown options for a Create Position row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array containing dropdown options."
                }
            ]
        },

        "getManageData": {
            "returnType": "string",
            "description": "Returns Manage Position table data."
        },

        "setManageData": {
            "description": "Sets Manage Position table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Manage table JSON data."
                }
            ]
        },

        "setManageCellValue": {
            "description": "Sets a value in a Manage table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Cell value."
                }
            ]
        },

        "setManageRowOptions": {
            "description": "Sets dropdown options for a Manage row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array containing dropdown options."
                },

                "getData2":       { "returnType": "string", "description": "Returns Tab 2 (Load/Modify/Delete) table data." },
"setData2":       { "description": "Sets Tab 2 table data.", "parameters": [{ "name": "data", "type": "string" }] },
"setCellValue2":  { "description": "Sets a cell in Tab 2.", "parameters": [{ "name": "rowIndex", "type": "integer" }, { "name": "fieldName", "type": "string" }, { "name": "value", "type": "string" }] },
"setRowOptions2": { "description": "Sets dropdown options for a Tab 2 row.", "parameters": [{ "name": "rowIndex", "type": "integer" }, { "name": "fieldName", "type": "string" }, { "name": "options", "type": "string" }] },
"getActiveTab":   { "returnType": "string", "description": "Returns the currently active tab key (create or modify)." },
"setActiveTab":   { "description": "Switches to the given tab.", "parameters": [{ "name": "tabKey", "type": "string" }] }
            ]
        }
    },

    "events": {

        "onFieldChange": {
            "description": "Triggered when a field value is changed in a row."
        },

        "onDataEntry": {
            "description": "Triggered when data is entered or a new row is added."
        },

        "onTabChange": {
            "description": "Triggered when the user changes between Create and Manage tabs."
        },

        "onSendForApproval": {
            "description": "Triggered when the user clicks Send for Approval."
        },

        "onValidate": {
            "description": "Triggered when the user clicks Validate."
        },

        "onClear": {
            "description": "Triggered when the user clicks Clear."
        },

        "onLoadManage": {
            "description": "Triggered when Manage data is requested."
        },

        "onSaveManage": {
            "description": "Triggered when selected Manage rows are saved."
        },

        "onDeleteManage": {
            "description": "Triggered when selected Manage rows are deleted."
        },
        
        "onTabChange":    { "description": "Fired when the user switches tabs." },
"onFieldChange2": { "description": "Tab 2 field value changed." },
"onDataEntry2":   { "description": "Tab 2 data entry, row add/copy/delete/select." },
"onValidate2":    { "description": "Tab 2 validate clicked." },
"onClear2":       { "description": "Tab 2 clear clicked." },
"onLoadData":     { "description": "Load Data button clicked on Tab 2." },
"onSaveChanges":  { "description": "Save Changes button clicked on Tab 2." }
    }
}
