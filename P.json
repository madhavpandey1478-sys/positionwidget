{
    "id": "com.madhav.positionentry",
    "version": "1.0.0",
    "name": "Position Entry",
    "description": "Position creation and maintenance data entry widget",
    "newInstancePrefix": "PositionEntry",
    "vendor": "Custom",
    "eula": "",
    "license": "",

    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-madhav-positionentry",
            "url": "https://madhavpandey1478-sys.github.io/positionwidget/Pmain.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],

    "properties": {
        "width": {
            "type": "integer",
            "default": 1800
        },
        "height": {
            "type": "integer",
            "default": 600
        }
    },

    "methods": {
        "getLastEvent": {
            "returnType": "string",
            "description": "Returns the last event generated by the widget.",
            "body": "return this.getLastEvent();"
        },

        "getData": {
            "returnType": "string",
            "description": "Returns the Create Position table data.",
            "body": "return this.getData();"
        },

        "setData": {
            "description": "Sets the Create Position table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Serialized table data."
                }
            ],
            "body": "this.setData(data);"
        },

        "setCellValue": {
            "description": "Sets a value in a Create Position table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Cell value."
                }
            ],
            "body": "this.setCellValue(rowIndex, fieldName, value);"
        },

        "setRowOptions": {
            "description": "Sets dropdown options for a Create Position row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array of dropdown options."
                }
            ],
            "body": "this.setRowOptions(rowIndex, fieldName, options);"
        },

        "getManageData": {
            "returnType": "string",
            "description": "Returns Manage Position table data.",
            "body": "return this.getManageData();"
        },

        "setManageData": {
            "description": "Sets Manage Position table data.",
            "parameters": [
                {
                    "name": "data",
                    "type": "string",
                    "description": "Manage table JSON data."
                }
            ],
            "body": "this.setManageData(data);"
        },

        "setManageCellValue": {
            "description": "Sets a value in a Manage table cell.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "value",
                    "type": "string",
                    "description": "Cell value."
                }
            ],
            "body": "this.setManageCellValue(rowIndex, fieldName, value);"
        },

        "setManageRowOptions": {
            "description": "Sets dropdown options for a Manage row.",
            "parameters": [
                {
                    "name": "rowIndex",
                    "type": "integer",
                    "description": "Row index."
                },
                {
                    "name": "fieldName",
                    "type": "string",
                    "description": "Field name."
                },
                {
                    "name": "options",
                    "type": "string",
                    "description": "JSON array of dropdown options."
                }
            ],
            "body": "this.setManageRowOptions(rowIndex, fieldName, options);"
        }
    },

    "events": {
        "onEvent": {
            "description": "Triggered whenever the widget generates an event."
        }
    }
}
